  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@resonance/core": "*",
    "@resonance/node": "*",
    "@resonance/relay": "*",
    "cli-table3": "^0.6.0",
    "sql.js": "^1.14.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "tsx": "^4.23.13",
    "typescript": "^5.7.0"
  }
}
